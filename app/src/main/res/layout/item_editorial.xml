<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/komix_charcoal_soft"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/komix_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_initial">

            <TextView
                android:id="@+id/txtInicial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/komix_white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="M" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreEditorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/komix_white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Marvel Comics" />

            <TextView
                android:id="@+id/txtPaisEditorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/komix_gray_text"
                android:textSize="13sp"
                tools:text="País: Estados Unidos · Fundada en 1939" />

            <TextView
                android:id="@+id/txtContactoEditorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/komix_aqua_light"
                android:textSize="12sp"
                tools:text="Contacto: contacto@marvel.com · Estado: Activa" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar"
            android:padding="8dp"
            android:src="@drawable/ic_edit_vector"
            app:tint="@color/komix_aqua" />

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar"
            android:padding="8dp"
            android:src="@drawable/ic_delete_vector"
            app:tint="@color/komix_red" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>